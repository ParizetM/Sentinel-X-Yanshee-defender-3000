# ============================================================
# SENTINEL-X REST API - CONFIGURATION PRODUCTION (INFRA SERVEUR)
# ============================================================

API_ENV=production
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=false
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=<cle_longue_aleatoire>
# Comptes du dashboard : login:motdepasse séparés par des virgules
API_USERS=admin:<mot_de_passe_admin>,supervisor:<mot_de_passe_superviseur>

# Cluster MariaDB Galera (Remplacer <IP_GALERA> par l'IP fournie par Elios/Benoit)
# Exemple : mysql+aiomysql://sentinel_user:<mot_de_passe_bdd>@172.16.137.21:3306/sentinel_db
DATABASE_URL=mysql+aiomysql://sentinel_user:<mot_de_passe_bdd>@172.16.137.10:3306/sentinel_db

# Broker Mosquitto
MQTT_BROKER_HOST=172.16.137.4
MQTT_BROKER_PORT=8883
MQTT_USERNAME=<utilisateur_broker>
MQTT_PASSWORD=<mot_de_passe_broker>
MQTT_USE_TLS=true
MQTT_CLIENT_ID=sentinel-api-prod

# Topics
MQTT_TELEMETRY_TOPIC=sentinelx/+/telemetry
MQTT_STATUS_TOPIC=sentinelx/+/status
MQTT_CMD_TOPIC_PREFIX=sentinelx
MQTT_ROBOT_CMD_TOPIC=detection_robot/command
MQTT_ROBOT_STATUS_TOPIC=detection_robot/action_status

# Flux vidéo relayés au dashboard (clé du flux comprise) : flux annoté YOLO, puis robot en repli
YOLO_STREAM_URL=http://172.16.137.6:8080/stream.mjpg?key=<SENTINEL_API_KEY>
ROBOT_STREAM_URL=http://10.0.3.234:8000/stream.mjpg?key=<SENTINEL_API_KEY>
