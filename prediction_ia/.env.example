# Copier ce fichier vers .env et renseigner les valeurs (.env n'est jamais commité)

# --- Broker Mosquitto ---
MQTT_BROKER_HOST =
# 8883 = MQTT sur TLS ; 1883 = en clair (avec MQTT_TLS = false, dépannage seulement)
MQTT_BROKER_PORT = 8883
MQTT_USERNAME =
MQTT_PASSWORD =
MQTT_CLIENT_ID = sentinel-x-anomaly

# --- TLS ---
# true : connexion chiffrée, certificat du broker vérifié contre le CA ci-dessous
MQTT_TLS = true
# Certificat de l'autorité (CA) : chemin absolu, ou relatif au dossier prediction_ia
MQTT_CA_CERT = ../yanshi_new/certs/ca.crt
# true : ne vérifie plus le nom d'hôte du certificat (la chaîne reste vérifiée). Dépannage uniquement.
MQTT_TLS_INSECURE = false

# --- Topics ---
TELEMETRY_TOPIC = sentinelx/+/telemetry
# Risque publié chaque seconde ({device} est remplacé par l'identifiant du boîtier)
ANOMALY_TOPIC = sentinelx/{device}/anomaly

# --- API REST (réception des alertes) ---
# Ex. : https://<ip-de-l-api>/api/v1/alerts — vide : les alertes sont seulement journalisées
API_ALERTS_URL =
# Jeton envoyé en « Authorization: Bearer » (POST /api/v1/auth/login)
API_TOKEN =
# CA de la PKI interne pour vérifier le certificat HTTPS de l'API (vide = magasin système)
API_CA_CERT =
API_TLS_VERIFY = true
API_TIMEOUT_S = 5
