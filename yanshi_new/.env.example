# Copier ce fichier vers .env et renseigner les valeurs

ROBOT_API_KEY =

# --- Broker Mosquitto ---
# Adresse IP de la machine qui héberge le broker
MQTT_BROKER_HOST =
# 8883 = port TLS usuel ; 1883 = port en clair (avec MQTT_TLS = false)
MQTT_BROKER_PORT = 8883
MQTT_USERNAME =
MQTT_PASSWORD =

# --- TLS ---
# true : connexion chiffrée, certificat du broker vérifié contre le CA
# ci-dessous. false : connexion en clair, sur le port 1883.
MQTT_TLS = true

# Certificat de l'autorité (CA) qui a signé le certificat du broker.
# Chemin absolu, ou relatif au dossier du script.
MQTT_CA_CERT = certs/ca.crt

# true : ne vérifie plus que le nom d'hôte du certificat serveur
# corresponde à MQTT_BROKER_HOST (la chaîne de certification reste
# vérifiée). Dépannage uniquement — à laisser à false sinon.
MQTT_TLS_INSECURE = false

# --- Flux vidéo annoté exposé en HTTP ---
# Clé exigée par /stream.mjpg : en-tête X-API-KEY ou paramètre ?key=.
# Obligatoire — le script refuse de démarrer si elle est absente.
SENTINEL_API_KEY =

# Interface d'écoute (0.0.0.0 = toutes les interfaces du réseau)
STREAM_HOST = 0.0.0.0
STREAM_PORT = 8080

# --- Affichage ---
# Fenêtre OpenCV locale. false = exécution sans écran : le flux HTTP reste
# servi, la sortie se fait par Ctrl+C.
SHOW_WINDOW = true
